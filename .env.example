# Postgres connection string (required).
DATABASE_URL=postgres://pgland:pgland@localhost:5432/pgland?sslmode=disable

# HTTP listen address. Default :8080.
HTTP_ADDR=:8080

# debug | info | warn | error. Default info.
LOG_LEVEL=info

# Grace period for in-flight requests on shutdown. Default 10s.
SHUTDOWN_TIMEOUT=10s

# Pull source definitions. Default sources.json. A missing file means no pull sources.
SOURCES_FILE=sources.json

# When set, POST /events/{source} requires
# X-Pgland-Signature: sha256=<hex HMAC-SHA256 of the body>.
INGEST_SECRET=
